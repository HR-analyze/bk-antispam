# --- Источник данных: выберите ОДИН вариант -------------------------------

# Вариант A (по умолчанию): дашборд сам ходит в PostgreSQL, только на чтение.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Вариант B: база недоступна с этой ВМ — ходим в API бота (api.py).
# Заполняйте только если DATABASE_URL пустой.
#UPSTREAM_API_URL=https://bot.example.ru
#UPSTREAM_API_KEY=тот_же_ключ_что_DASHBOARD_API_KEY_у_бота

# --- Доступ к самому дашборду ---------------------------------------------
# Обязательно, иначе дашборд отвечает 503.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=смените_меня
# Запуск без пароля (только для локальной отладки):
#DASHBOARD_ALLOW_ANONYMOUS=1

# --- Прочее ---------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Публичный @username чата: нужен только для ссылок «открыть в Telegram»
# в публичных группах. Для приватных супергрупп ссылка строится из chat_id.
#CHAT_USERNAME=
