# Telegram
BOT_TOKEN=
# ID группы обсуждений, например -1001234567890. Пусто — бот модерирует любой чат.
CHAT_ID=

# PostgreSQL: без него бот работает, но ничего не логирует
DATABASE_URL=

# Ключ для HTTP-API (api.py), из которого дашборд может брать данные
DASHBOARD_API_KEY=
# Через запятую: origin'ы, которым разрешён CORS. По умолчанию "*"
DASHBOARD_CORS_ORIGINS=

# Порт API, поднимаемого рядом с ботом (main.py)
PORT=8000

# Поднимать ли поллинг-бота в этом процессе. Любое из 0/false/no/off — только
# веб-часть, без бота и без токена. Нужно, если платформа держит больше одного
# инстанса ради веб-части: поллинг обязан жить ровно в одном экземпляре.
RUN_BOT=1

# Окно схлопывания повторов в логе, секунды. 0 — не схлопывать. При конфликте
# токена aiogram ретраит вечно и без окна пишет ~17 тысяч строк в сутки.
LOG_THROTTLE_SECONDS=300
